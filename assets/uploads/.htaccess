# ========================================================
# RiTiVerse - Uploads Directory Protection
# Prevents execution of scripts uploaded to this directory
# ========================================================

# Disable script execution
<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|cgi|asp|js|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Turn off PHP engine if mod_php is active
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Disable directory listing and CGI
Options -Indexes -ExecCGI
